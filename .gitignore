# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.*
!.env.example

# ── AI model files (NEVER commit — sizes are gigabytes) ───────────────────────
ai-service/models/
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.h5
*.onnx

# ── Qdrant persistent vector storage ──────────────────────────────────────────
ai-service/qdrant_storage/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.Python
*.egg-info/
dist/
*.egg
pip-log.txt

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Databases (never commit live DB — use seed scripts instead) ───────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ── Uploads and user-generated files ─────────────────────────────────────────
uploads/
downloads/
files/

# ── Generated binary / office documents ──────────────────────────────────────
# Source Markdown docs are kept; generated PDFs are excluded by default.
# To intentionally version a PDF, use: git add -f path/to/file.pdf
*.pdf
*.docx
*.pptx
*.xlsx
*.xls
*.doc

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Temporary / cache ────────────────────────────────────────────────────────
tmp/
temp/
.cache/
*.tmp

# ── Build and coverage artifacts ─────────────────────────────────────────────
coverage/
dist/
build/
.next/
out/
.nuxt/
.svelte-kit/
.parcel-cache/
.nyc_output/
*.lcov
*.tsbuildinfo

# ── Package manager caches ────────────────────────────────────────────────────
.npm/
.eslintcache
.stylelintcache
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# ── Misc runtime files ────────────────────────────────────────────────────────
*.pid
*.pid.lock
*.seed
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

