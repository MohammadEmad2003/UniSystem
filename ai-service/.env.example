PORT=7860
BACKEND_API_URL=http://localhost:3000
INTERNAL_API_KEY=your-secret-ai-key
QDRANT_IN_MEMORY=false
QDRANT_PATH=./qdrant_storage
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ENABLE_OCR=true
# Use appropriate path for your deployment (e.g. /usr/bin/tesseract for linux)
TESSERACT_CMD=/usr/bin/tesseract
ENABLE_MATERIAL_SUMMARY=false
PDF_CHUNK_SIZE=500
PDF_CHUNK_OVERLAP=100
PDF_BASE_URL=http://localhost:3001

# ── Local LLM (llama-cpp-python + GGUF) ──────────────────────────────────────
LOCAL_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
LOCAL_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_MODEL_DIR=./models
LOCAL_MODEL_CTX=2048
LOCAL_MODEL_THREADS=4
LOCAL_MODEL_GPU_LAYERS=0
