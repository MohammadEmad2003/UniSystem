# ── FastAPI service ───────────────────────────────────────────────────────────
PORT=9000

# ── Backend connection ────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:3000
# Shared secret between Node backend and AI service (must match backend .env)
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# ── Qdrant vector store ───────────────────────────────────────────────────────
# true  = non-persistent in-memory (fastest for dev, resets on restart)
# false = persistent on disk at QDRANT_PATH
QDRANT_IN_MEMORY=false
QDRANT_PATH=./qdrant_storage

# ── Embedding model (sentence-transformers, auto-downloaded on first run) ─────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Run: ollama serve   then   ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Fallback / lighter model (used by local_llm_transformers if Ollama is absent)
QWEN_MODEL=qwen2.5:1.5b-instruct

# ── PDF processing ────────────────────────────────────────────────────────────
PDF_CHUNK_SIZE=900
PDF_CHUNK_OVERLAP=150
# URL base for fetching uploaded PDFs from the backend
PDF_BASE_URL=http://localhost:3001

# ── OCR (Tesseract) ──────────────────────────────────────────────────────────
ENABLE_OCR=true
# Windows default path — adjust for your OS / install location
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Feature flags ─────────────────────────────────────────────────────────────
# Whether to pre-compute material summaries at index time (slow, high memory)
ENABLE_MATERIAL_SUMMARY=false

# ── Retrieval thresholds ──────────────────────────────────────────────────────
# Cosine similarity threshold to reuse a previous Q&A answer (0–1)
QA_REUSE_THRESHOLD=0.78
# Minimum chunk score to attempt material-based answering
MATERIAL_MATCH_THRESHOLD=0.50
# Minimum LLM confidence to accept a material-based answer
ANSWER_CONFIDENCE_THRESHOLD=0.6

# ── Token / generation limits ────────────────────────────────────────────────
# Max tokens Ollama may generate per response (-1 = model default)
OLLAMA_NUM_PREDICT=-1
