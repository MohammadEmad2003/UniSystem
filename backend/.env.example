# ── Express server ────────────────────────────────────────────────────────────
PORT=3000

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string used to sign JWT tokens
JWT_SECRET=change-me-to-a-long-random-secret

# ── Internal API key (must match ai-service INTERNAL_API_KEY) ────────────────
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# ── AI service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:9000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path (relative to backend/)
DATABASE_PATH=./database.db

# ── Email (optional — used for verification and password reset) ───────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=no-reply@unisystem.edu
