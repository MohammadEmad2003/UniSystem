# ── Backend API ───────────────────────────────────────────────────────────────
# Node/Express backend base URL (must end with /api)
VITE_API_BASE_URL=http://localhost:3000/api

# ── AI service ────────────────────────────────────────────────────────────────
# FastAPI AI service base URL (used for Study-with-AI tools)
VITE_AI_BASE_URL=http://localhost:9000

# ── Data source toggle ────────────────────────────────────────────────────────
# "true"  = use in-memory mock data (no backend required)
# "false" = use real Node + AI backend
VITE_USE_MOCK=false
